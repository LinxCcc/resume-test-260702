#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

node /var/www/resume/current/server/change-password.mjs \
  /etc/resume-site/resume-site.env
systemctl restart resume-site.service
systemctl is-active --quiet resume-site.service

echo "共享密码修改成功，旧登录会话已全部失效。"
